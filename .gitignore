data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite-journal
# imágenes/archivos generados por herramientas (caducan a los 7 días)
data/adjuntos/
# catálogo de precios: se descarga solo (2,5 MB, cambia a diario)
data/litellm_cost.json
qdrant_storage/
*.rdb

